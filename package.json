{
  "name": "home-office",
  "private": true,
  "license": "MIT",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "spikes/s1-claude-alpine",
      "spikes/s3-docker-api",
      "spikes/s4-orpc-ws",
      "spikes/s5-git-bridge"
    ],
    "catalog": {
      "@modelcontextprotocol/sdk": "1.30.0",
      "@orpc/client": "1.15.0",
      "@orpc/contract": "1.15.0",
      "@orpc/server": "1.15.0",
      "@types/bun": "1.4.1",
      "drizzle-kit": "0.31.10",
      "drizzle-orm": "0.45.2",
      "knip": "6.34.0",
      "oxfmt": "0.66.0",
      "oxlint": "1.81.0",
      "oxlint-tsgolint": "7.0.2001",
      "pino": "10.3.1",
      "typescript": "7.0.2",
      "zod": "4.5.4"
    }
  },
  "type": "module",
  "scripts": {
    "check": "bun run typecheck && bun run lint && bun run fmt:check && bun run knip",
    "typecheck": "bun run scripts/typecheck.ts",
    "lint": "oxlint --type-aware --deny-warnings",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "knip": "knip",
    "setup": "git config core.hooksPath .githooks",
    "assets:manifest": "bun run scripts/assets-manifest.ts"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "knip": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "bun": ">=1.4.2"
  },
  "packageManager": "bun@1.4.2"
}
