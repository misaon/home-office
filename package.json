{
  "name": "home-office",
  "private": true,
  "license": "MIT",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "spikes/s6-acp-mock"
    ],
    "catalog": {
      "@agentclientprotocol/sdk": "1.4.0",
      "@modelcontextprotocol/sdk": "1.30.0",
      "@orpc/client": "1.15.0",
      "@orpc/contract": "1.15.0",
      "@orpc/server": "1.15.0",
      "@tanstack/react-query": "5.102.8",
      "@types/bun": "1.4.2",
      "@types/react": "19.2.18",
      "@types/react-dom": "19.2.7",
      "bun-plugin-tailwind": "0.1.2",
      "drizzle-kit": "0.31.10",
      "drizzle-orm": "0.45.2",
      "electrobun": "2.0.1",
      "knip": "6.35.0",
      "oxfmt": "0.67.0",
      "oxlint": "1.82.0",
      "oxlint-tsgolint": "7.0.2001",
      "pino": "10.3.1",
      "pixi.js": "8.20.1",
      "react": "19.2.8",
      "react-dom": "19.2.8",
      "sharp": "0.35.4",
      "tailwindcss": "4.3.3",
      "tinyqueue": "3.0.0",
      "type-fest": "5.9.0",
      "typescript": "7.0.2",
      "yoctocolors": "2.2.0",
      "zod": "4.5.4",
      "zustand": "5.0.15"
    }
  },
  "type": "module",
  "scripts": {
    "check": "bun run typecheck && bun run lint && bun run fmt:check && bun run knip && bun run ui:build",
    "typecheck": "bun run scripts/typecheck.ts",
    "lint": "oxlint --type-aware --deny-warnings",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "knip": "knip",
    "setup": "git config core.hooksPath .githooks",
    "ui:build": "bun run scripts/ui-build.ts",
    "ui:watch": "bun run scripts/ui-build.ts --watch",
    "desktop:prepare": "bun run scripts/desktop-prepare.ts",
    "desktop:dev": "bun run desktop:prepare && bun run scripts/devkit.ts dev",
    "desktop:build": "bun run desktop:prepare && bun run scripts/devkit.ts build",
    "devkit": "bun run scripts/devkit.ts"
  },
  "devDependencies": {
    "@ho/protocol": "workspace:*",
    "@types/bun": "catalog:",
    "bun-plugin-tailwind": "catalog:",
    "knip": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "sharp": "catalog:",
    "typescript": "catalog:"
  },
  "overrides": {
    "esbuild": "0.28.2"
  },
  "engines": {
    "bun": ">=1.4.2"
  },
  "packageManager": "bun@1.4.2",
  "trustedDependencies": [
    "electrobun",
    "sharp"
  ]
}
