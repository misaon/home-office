{
  "name": "home-office",
  "private": true,
  "license": "MIT",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "spikes/s1-claude-alpine",
      "spikes/s3-docker-api",
      "spikes/s4-orpc-ws",
      "spikes/s5-git-bridge"
    ],
    "catalog": {
      "@modelcontextprotocol/sdk": "1.30.0",
      "@orpc/client": "1.15.0",
      "@orpc/contract": "1.15.0",
      "@orpc/server": "1.15.0",
      "@types/bun": "1.4.1",
      "@types/react": "19.2.18",
      "@types/react-dom": "19.2.7",
      "bun-plugin-tailwind": "0.1.2",
      "drizzle-kit": "0.31.10",
      "drizzle-orm": "0.45.2",
      "electrobun": "2.0.1",
      "knip": "6.34.0",
      "oxfmt": "0.66.0",
      "oxlint": "1.81.0",
      "oxlint-tsgolint": "7.0.2001",
      "pino": "10.3.1",
      "pixi.js": "8.20.1",
      "react": "19.2.8",
      "react-dom": "19.2.8",
      "tailwindcss": "4.3.3",
      "typescript": "7.0.2",
      "zod": "4.5.4",
      "zustand": "5.0.15"
    }
  },
  "type": "module",
  "scripts": {
    "check": "bun run typecheck && bun run lint && bun run fmt:check && bun run knip",
    "typecheck": "bun run scripts/typecheck.ts",
    "lint": "oxlint --type-aware --deny-warnings",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "knip": "knip",
    "setup": "git config core.hooksPath .githooks",
    "assets:manifest": "bun run scripts/assets-manifest.ts",
    "assets:import": "bun run scripts/assets-import.ts",
    "assets:placeholders": "bun run scripts/assets-placeholders.ts",
    "ui:build": "bun run scripts/ui-build.ts",
    "ui:watch": "bun run scripts/ui-build.ts --watch",
    "office:lab": "bun run scripts/office-lab.ts",
    "desktop:prepare": "bun run scripts/desktop-prepare.ts",
    "desktop:dev": "bun run desktop:prepare && cd apps/desktop && hutch electrobun dev",
    "desktop:build": "bun run desktop:prepare && cd apps/desktop && hutch electrobun build --env=stable",
    "assets:workstation": "bun run scripts/assets-workstation.ts"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "bun-plugin-tailwind": "catalog:",
    "knip": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "bun": ">=1.4.2"
  },
  "packageManager": "bun@1.4.2"
}
