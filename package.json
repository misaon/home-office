{
  "name": "home-office",
  "private": true,
  "license": "MIT",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "spikes/*"
    ],
    "catalog": {
      "@agentclientprotocol/sdk": "1.4.0",
      "@base-ui/react": "1.8.0",
      "@modelcontextprotocol/sdk": "1.30.0",
      "@orpc/client": "1.15.1",
      "@orpc/contract": "1.15.1",
      "@orpc/server": "1.15.1",
      "@tailwindcss/cli": "4.3.3",
      "@tanstack/react-query": "5.102.8",
      "@types/bun": "1.4.2",
      "@types/react": "19.3.0",
      "@types/react-dom": "19.3.0",
      "electrobun": "2.0.1",
      "i18next": "26.4.2",
      "knip": "6.35.1",
      "lucide-react": "1.46.0",
      "oxfmt": "0.68.0",
      "oxlint": "1.83.0",
      "oxlint-tsgolint": "7.0.2001",
      "pino": "10.3.1",
      "pixi.js": "8.20.1",
      "react": "19.3.0",
      "react-dom": "19.3.0",
      "react-i18next": "17.0.14",
      "tailwindcss": "4.3.3",
      "tinyqueue": "3.0.0",
      "typescript": "7.0.2",
      "zod": "4.6.5",
      "zustand": "5.0.15"
    }
  },
  "type": "module",
  "scripts": {
    "check": "bun run typecheck && bun run lint && bun run fmt:check && bun run knip && bun run ui:build",
    "typecheck": "bun run scripts/typecheck.ts",
    "lint": "oxlint --deny-warnings",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "knip": "knip",
    "setup": "git config core.hooksPath .githooks",
    "ui:build": "bun run scripts/ui-build.ts",
    "ui:watch": "bun run scripts/ui-build.ts --watch",
    "desktop:prepare": "bun run scripts/desktop-prepare.ts",
    "desktop:dev": "bun run desktop:prepare && bun run scripts/devkit.ts dev",
    "desktop:build": "bun run desktop:prepare && bun run scripts/devkit.ts build",
    "devkit": "bun run scripts/devkit.ts",
    "spike:task-engine": "bun run spikes/task-engine/src/run.ts",
    "spike:acp-mock": "bun run spikes/s6-acp-mock/src/run.ts",
    "cli:build": "bun build --compile --minify apps/cli/src/main.ts --outfile apps/cli/dist/ho"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "knip": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "bun": ">=1.4.2"
  },
  "packageManager": "bun@1.4.2",
  "trustedDependencies": [
    "electrobun"
  ]
}
