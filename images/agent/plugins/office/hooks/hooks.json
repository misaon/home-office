{
  "description": "The office refuses commands that waste the session or hide a failure",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bun",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/guard-bash.ts"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
