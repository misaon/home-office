{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["esnext", "dom", "dom.iterable"],
    "paths": {
      "electrobun": ["./.hutch/devkit/api/sdks/main/index.ts"],
      "electrobun/main": ["./.hutch/devkit/api/sdks/main/index.ts"],
      "electrobun/view": ["./.hutch/devkit/api/browser/index.ts"]
    },
    "tsBuildInfoFile": "../../.tscache/apps-desktop.tsbuildinfo",
    // The Electrobun devkit is typechecked as source through `paths`. Measured 2026-09-09: it breaks these
    // two flags in 15 and 1 places, all inside .hutch/devkit and none in apps/desktop/src. Declaration-only
    // emit for the devkit (which would keep it out of this program) fails with TS4094 on its own source.
    "exactOptionalPropertyTypes": false,
    "noImplicitReturns": false
  },
  "include": ["src", "electrobun.config.ts", "hutch.config.ts"]
}
