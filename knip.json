{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.ts"],
      "project": ["scripts/**/*.ts"]
    },
    "packages/*": {
      "project": ["src/**/*.{ts,tsx}"]
    },
    "spikes/*": {
      "entry": ["src/*.ts"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "apps/desktop": {
      "entry": ["src/bun/index.ts", "electrobun.config.ts", "hutch.config.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/ui": {
      "entry": ["src/main.tsx", "src/styles.css"],
      "project": ["src/**/*.{ts,tsx,css}"]
    },
    "apps/cli": {
      "project": ["src/**/*.ts"]
    }
  },
  "ignoreWorkspaces": ["packages/agent-kit"]
}
