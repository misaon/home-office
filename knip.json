{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.ts"],
      "project": ["scripts/**/*.ts"],
      "ignoreBinaries": ["hdiutil"]
    },
    "packages/*": {
      "project": ["src/**/*.{ts,tsx}"],
      "includeEntryExports": true
    },
    "spikes/*": {
      "entry": ["src/*.ts"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "apps/desktop": {
      "entry": ["src/bun/index.ts", "electrobun.config.ts", "hutch.config.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/ui": {
      "entry": ["src/main.tsx", "src/design/app.css"],
      "project": ["src/**/*.{ts,tsx,css}"],
      "ignoreDependencies": ["@tailwindcss/cli"]
    },
    "apps/cli": {
      "project": ["src/**/*.ts"]
    }
  }
}
